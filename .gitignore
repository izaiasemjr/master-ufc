# Dados de bases biométricas e artefatos de execução são estritamente locais.
# Os únicos arquivos versionados nestas árvores são os marcadores vazios.
# Configurações reproduzíveis pertencem a configs/, nunca a data/.
data/bases/**
!data/bases/.gitkeep
data/results/**
!data/results/.gitkeep

# Uma nuvem PCD nunca deve entrar no repositório, mesmo se for colocada fora
# das pastas de dados por engano.
*.[pP][cC][dD]

# Python runtime artifacts
__pycache__/
*.py[cod]

# PCL's temporary files can be left after an interrupted run.
*.preprocess-tmp.pcd
*.outlier-tmp.pcd
*.tmp.pcd

# CMake build products and timing files written by the legacy C++ executables.
src/**/build/
*.times.dat
